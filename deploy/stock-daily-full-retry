#!/usr/bin/env bash
set -uo pipefail

cd /opt/stock

retry_needed="$('/opt/stock/.venv/bin/python' - <<'PY'
from web_app.services.update_service import needs_daily_update_retry

print("yes" if needs_daily_update_retry() else "no")
PY
)"

if [[ "$retry_needed" != "yes" ]]; then
  exit 0
fi

exec /usr/local/sbin/stock-daily-full-update
