#!/usr/bin/env bash
set -uo pipefail

cd /opt/stock

retry_needed="$('/opt/stock/.venv/bin/python' - <<'PY'
import json
from datetime import datetime
from pathlib import Path
from zoneinfo import ZoneInfo

path = Path("data/web_update_status.json")
try:
    status = json.loads(path.read_text(encoding="utf-8"))
except (OSError, ValueError):
    status = {}

today = datetime.now(ZoneInfo("Asia/Shanghai")).strftime("%Y%m%d")
started_at = str(status.get("started_at") or "")[:10].replace("-", "")
finished = status.get("state") == "finished" and status.get("returncode") in (0, None)
print("no" if finished and started_at == today else "yes")
PY
)"

if [[ "$retry_needed" != "yes" ]]; then
  exit 0
fi

exec /usr/local/sbin/stock-daily-full-update
